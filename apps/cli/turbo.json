{
  "$schema": "../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tools/native-fs/**",
        "$TURBO_ROOT$/tools/cli-package/files.mjs",
        "$TURBO_ROOT$/.github/workflows/native-fs.yml"
      ],
      "outputs": ["dist/**", "drizzle/**", "native/fs-metadata/runtime/**"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    }
  }
}
